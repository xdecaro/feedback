<?xml version="1.0" encoding="utf-8"?>
<extension type="component" method="upgrade">
  <name>COM_XDECAROFEEDBACK</name>
  <author>Luca De Caro</author>
  <creationDate>2026-09</creationDate>
  <license>GNU General Public License version 2 or later</license>
  <authorUrl>https://github.com/xdecaro/feedback</authorUrl>
  <version>0.2.0</version>
  <description>COM_XDECAROFEEDBACK_XML_DESCRIPTION</description>
  <namespace path="src">xdecaro\Component\Feedback</namespace>
  <targetplatform name="joomla" version="(4|5|6).*"/>
  <administration>
    <menu view="dashboard">COM_XDECAROFEEDBACK</menu>
    <submenu>
      <menu view="dashboard">COM_XDECAROFEEDBACK_DASHBOARD</menu>
      <menu view="questions">COM_XDECAROFEEDBACK_QUESTION_LIBRARY</menu>
      <menu view="information">COM_XDECAROFEEDBACK_INFORMATION</menu>
    </submenu>
    <files folder="admin">
      <filename>access.xml</filename>
      <filename>config.xml</filename>
      <folder>forms</folder>
      <folder>language</folder>
      <folder>services</folder>
      <folder>sql</folder>
      <folder>src</folder>
      <folder>tmpl</folder>
    </files>
  </administration>
  <media destination="com_xdecarofeedback" folder="media">
    <filename>joomla.asset.json</filename>
    <folder>css</folder>
  </media>
  <install>
    <sql>
      <file driver="mysql" charset="utf8">sql/install.mysql.utf8mb4.sql</file>
    </sql>
  </install>
  <update>
    <schemas>
      <schemapath type="mysql">sql/updates/mysql</schemapath>
    </schemas>
  </update>
</extension>
